# ─────────────────────────────────────────────
# AIDevOps Monitoring — environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────

# ── App ──
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# ── Database ──
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aidevops

# ── Security ──
# Admin secret for registering projects.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET=

# ── Ingestion ──
INGEST_QUEUE_SIZE=5000
INGEST_WORKERS=4
SHUTDOWN_TIMEOUT=15s
# ── Local test account (used by tests/auth/auth_flow.sh) ──
# Any email + a password of 8-72 characters. Local testing only.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── Dashboard ──
# Web addresses allowed to call the API from a browser (comma-separated).
DASHBOARD_ORIGINS=http://localhost:5173
